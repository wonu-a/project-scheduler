/* Project Scheduler — dark theme. Keep selectors identical in light.qss and dark.qss. */

QMainWindow#mainWindow, QWidget#centralArea, QWidget#contentArea {
    background: #0e131d;
}
QWidget {
    color: #e4e7ee;
    font-size: 13px;
}
QDialog, QMessageBox {
    background: #161c29;
}

/* Menus */
QMenuBar {
    background: #161c29;
    border-bottom: 1px solid #252d3d;
    padding: 2px 8px;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background: #262c4d;
    color: #c9ccff;
}
QMenu {
    background: #161c29;
    border: 1px solid #252d3d;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 6px 28px 6px 24px;
    border-radius: 6px;
}
QMenu::item:selected {
    background: #262c4d;
    color: #c9ccff;
}
QMenu::item:disabled {
    color: #94a0b4;
}
QMenu::separator {
    height: 1px;
    background: #252d3d;
    margin: 6px 8px;
}

/* Toolbar */
QToolBar#mainToolBar {
    background: #161c29;
    border: none;
    border-bottom: 1px solid #252d3d;
    padding: 6px 14px;
    spacing: 4px;
}
QToolBar#mainToolBar::separator {
    background: #252d3d;
    width: 1px;
    margin: 6px 8px;
}
QToolBar#mainToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 5px 10px;
    color: #e4e7ee;
}
QToolBar#mainToolBar QToolButton:hover {
    background: #1d2434;
    border-color: #252d3d;
}
QToolBar#mainToolBar QToolButton:pressed {
    background: #262c4d;
}
QToolBar#mainToolBar QToolButton:disabled {
    color: #94a0b4;
}

/* Header bar */
QFrame#headerBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1e1b4b, stop:1 #3730a3);
    border: none;
}
QLabel#appTitle {
    color: #ffffff;
    font-size: 20px;
    font-weight: 600;
    background: transparent;
}
QLabel#fileLabel {
    color: #b2b6f0;
    font-size: 12px;
    background: transparent;
}
QLabel#appIcon {
    background: transparent;
}
QFrame#statCard {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 10px;
    min-width: 110px;
}
QFrame#statCard[critical="true"] {
    background: rgba(239,68,68,0.28);
    border-color: rgba(252,165,165,0.45);
}
QLabel#statValue {
    color: #ffffff;
    font-size: 18px;
    font-weight: 600;
    background: transparent;
}
QLabel#statCaption {
    color: #b2b6f0;
    font-size: 11px;
    background: transparent;
}

/* Inputs */
QLineEdit, QSpinBox, QDateEdit {
    background: #161c29;
    border: 1px solid #343e52;
    border-radius: 7px;
    padding: 6px 8px;
    selection-background-color: #7c83ff;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDateEdit:focus {
    border-color: #7c83ff;
}
QLineEdit#filterEdit {
    min-width: 280px;
}
QSpinBox::up-button, QSpinBox::down-button {
    width: 18px;
    border: none;
    background: transparent;
}
QSpinBox::up-arrow {
    image: url(:/icons/sort-up.svg);
    width: 12px;
    height: 12px;
}
QSpinBox::down-arrow {
    image: url(:/icons/sort-down.svg);
    width: 12px;
    height: 12px;
}
QDateEdit::drop-down {
    border: none;
    width: 24px;
}
QDateEdit::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 14px;
    height: 14px;
}

/* Task table */
QTableView#taskTable {
    background: #161c29;
    alternate-background-color: #191f2d;
    border: 1px solid #252d3d;
    border-radius: 10px;
    selection-background-color: #2f3668;
    selection-color: #eef0ff;
    gridline-color: #252d3d;
}
QTableView#taskTable::item {
    padding: 0 8px;
    border: none;
}
QTableView#taskTable::item:selected {
    background: #2f3668;
    color: #eef0ff;
}
QHeaderView {
    background: transparent;
}
QHeaderView::section {
    background: #1a2130;
    color: #94a0b4;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 8px;
    border: none;
    border-bottom: 1px solid #252d3d;
}
QHeaderView::section:hover {
    background: #1d2434;
    color: #e4e7ee;
}
QHeaderView::up-arrow {
    image: url(:/icons/sort-up.svg);
    width: 12px;
    height: 12px;
}
QHeaderView::down-arrow {
    image: url(:/icons/sort-down.svg);
    width: 12px;
    height: 12px;
}
QTableCornerButton::section {
    background: #1a2130;
    border: none;
}

/* Critical-path treatment */
QLabel#criticalBadge {
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
    background: #232a3a;
    color: #94a0b4;
}
QLabel#criticalBadge[critical="true"] {
    background: #3a1f25;
    color: #ff9d9d;
    border: 1px solid #6b2f36;
}
QLabel#legendLabel {
    color: #94a0b4;
    font-size: 12px;
}

/* Date picker popup (QDateEdit calendar) */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background: #161c29;
    border-bottom: 1px solid #252d3d;
    padding: 4px;
}
QCalendarWidget QToolButton {
    background: transparent;
    color: #e4e7ee;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
    font-weight: 600;
}
QCalendarWidget QToolButton:hover {
    background: #1d2434;
    border-color: #252d3d;
}
QCalendarWidget QToolButton:pressed {
    background: #262c4d;
}
QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: url(:/icons/chevron-left.svg);
}
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: url(:/icons/chevron-right.svg);
}
QCalendarWidget QToolButton#qt_calendar_monthbutton {
    padding-right: 20px;
}
QCalendarWidget QToolButton::menu-indicator {
    image: url(:/icons/chevron-down.svg);
    subcontrol-position: right center;
    subcontrol-origin: padding;
    width: 12px;
    height: 12px;
    right: 4px;
}
QCalendarWidget QAbstractItemView {
    background: #161c29;
    alternate-background-color: #1a2130;
    color: #e4e7ee;
    selection-background-color: #7c83ff;
    selection-color: #ffffff;
    outline: none;
    border: none;
}
QCalendarWidget QAbstractItemView:disabled {
    color: #94a0b4;
}

/* Lists */
QListView, QListWidget {
    background: #161c29;
    border: 1px solid #252d3d;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}
QListView::item, QListWidget::item {
    padding: 5px 6px;
    border-radius: 5px;
}
QListView::item:hover, QListWidget::item:hover {
    background: #1d2434;
}
QListView::item:selected, QListWidget::item:selected {
    background: #2f3668;
    color: #eef0ff;
}
QCheckBox {
    spacing: 8px;
}
QCheckBox::indicator, QListView::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #343e52;
    border-radius: 4px;
    background: #161c29;
}
QCheckBox::indicator:checked, QListView::indicator:checked {
    background: #7c83ff;
    border-color: #7c83ff;
    image: url(:/icons/check.svg);
}

/* Dialogs */
QLabel#dialogTitle {
    font-size: 17px;
    font-weight: 600;
    color: #e4e7ee;
    padding-bottom: 4px;
}
QLabel#sectionLabel {
    color: #94a0b4;
    font-size: 12px;
    font-weight: 600;
    padding-top: 6px;
}
QLabel#emptyHint {
    background: #1a2130;
    color: #94a0b4;
    border: 1px dashed #343e52;
    border-radius: 8px;
    padding: 12px 14px;
}
QLabel#errorLabel {
    background: #3a1f25;
    color: #ff9d9d;
    border: 1px solid #6b2f36;
    border-radius: 7px;
    padding: 8px 10px;
}
QPushButton {
    background: #161c29;
    border: 1px solid #343e52;
    border-radius: 7px;
    padding: 6px 16px;
}
QPushButton:hover {
    background: #1d2434;
}
QPushButton:pressed {
    background: #262c4d;
}
QPushButton:default {
    background: #7c83ff;
    border-color: #7c83ff;
    color: #ffffff;
}
QPushButton:default:hover {
    background: #9197ff;
}
QPushButton:disabled {
    color: #94a0b4;
    background: #0e131d;
}

/* Scroll bars */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #343e52;
    border-radius: 4px;
    min-height: 32px;
    min-width: 32px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #4a566e;
}
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0;
    height: 0;
}

/* Status bar and tooltips */
QStatusBar {
    background: #161c29;
    border-top: 1px solid #252d3d;
    color: #94a0b4;
}
QToolTip {
    background: #e4e7ee;
    color: #0e131d;
    border: none;
    border-radius: 6px;
    padding: 5px 8px;
}
